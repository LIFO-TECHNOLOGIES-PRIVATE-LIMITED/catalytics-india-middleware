TALLY_DB_PATH=C:\path\to\tally_dc.sqlite
TALLY_URL=http://localhost:9000/
TALLY_COMPANY=BHARATH OXYGEN LICENSEE
CATALYTICS_ENTITY_ID=25
CATALYTICS_API_BASE_URL=http://localhost:8000
CATALYTICS_API_KEY=YOUR_API_KEY
# Source mode for DC creation:
# - delivery_note: fetch Delivery Notes and sync as DC
# - sales_invoice: fetch Sales Invoices and sync as DC (all customers in this instance)
# For mixed customer routing (some from delivery note, some from invoice), run two middleware
# instances with separate TALLY_DB_PATH and UI_PORT.
TALLY_SOURCE_DOC=delivery_note
TALLY_FETCH_STOCK=true
TALLY_FETCH_FULL_CUSTOMERS=false
TALLY_FETCH_FULL_PRODUCTS=false
TALLY_FETCH_FULL_PRODUCTS_AUTO_HSN=true
TALLY_FETCH_FULL_PRODUCTS_AUTO_CODE=true
AUTO_SYNC_CUSTOMERS=false
AUTO_SYNC_PRODUCTS=false
# Base loop interval (seconds, minimum 10)
SYNC_INTERVAL=300
# Optional per-domain intervals (seconds, minimum 10)
AUTO_SYNC_CUSTOMERS_INTERVAL_SEC=300
AUTO_SYNC_PRODUCTS_INTERVAL_SEC=300
SYNC_BATCH_SIZE=10
SYNC_LIMIT=200
SYNC_MAX_ATTEMPTS=5
SYNC_ALLOW_TALLY_FETCH=false
LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE=C:\Github\catalytics-india-middleware\logs\app.log
UI_HOST=0.0.0.0
UI_PORT=8787
UI_API_KEY=
UI_AUTO_START=false
