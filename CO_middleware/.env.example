# Chennai Oxygen Middleware Configuration

# ============================================================================
# ENTITY CONFIGURATION
# ============================================================================
ENTITY_NAME=Chennai Oxygen
ENTITY_ID=1
# ENTITY_ID is aliased to CATALYTICS_ENTITY_ID automatically.
DEFAULT_ADMIN_USER_ID=55

# Used when invoice does not contain godown/location/filling station.
DEFAULT_FILLING_STATION=
DEFAULT_FILLING_STATION_ID=

# ============================================================================
# CATALYTICS BACKEND API
# ============================================================================
CATALYTICS_API_BASE_URL=http://localhost:8000/
# Optional compatibility alias if you still use older scripts:
# CATALYTICS_API_BASE=http://localhost:8000/
CATALYTICS_API_KEY=your-api-key-here

# ============================================================================
# TALLY CONFIGURATION
# ============================================================================
TALLY_URL=http://localhost:9000/

# Single active company used by the current dashboard automation.
TALLY_COMPANY=COMPANY NAME 1

# Single SQLite database used for customers, products, and delivery challans.
TALLY_DB_PATH=tally_dc.sqlite

# Cooldown between Tally requests in seconds. Do not set below 10.
TALLY_REQUEST_COOLDOWN=10.0

# Multi-company configuration (optional)
TALLY_COMPANY_1=COMPANY NAME 1
TALLY_COMPANY_2=
TALLY_COMPANY_3=
TALLY_COMPANY_4=

# Active companies (comma-separated: COMPANY_1,COMPANY_2,COMPANY_3,COMPANY_4)
TALLY_COMPANY_ACTIVE=COMPANY_1

# Product type mapping (code in stock item name parentheses -> full type name)
PRODUCT_TYPE_MAP=CYL:CYLINDER,PLT:PALLET,TNK:TANK,CON:CONTAINER

# Products to fetch by exact keyword match (optional)
PRODUCT_EXACT_KEYWORDS=

# Fetch stock item details with each DC (slow - keep false for speed)
TALLY_FETCH_STOCK=false

# How many days back to fetch DCs (0 = today only)
TALLY_DAYS_BACK=0

# Only fetch DCs whose reference fields contain at least one of these keywords
DC_REFERENCE_KEYWORDS=delivery,customer pickup,supplier,traders

# ============================================================================
# SYNC CONFIGURATION
# ============================================================================
# Sync frequency (seconds) for pending products, customers, and delivery challans.
SYNC_INVOICES_INTERVAL_SECONDS=120

# Master-data fetch frequency (minutes) for products + customers.
FETCH_MASTER_INTERVAL_MINUTES=30

# Delivery challan fetch frequency.
FETCH_INVOICES_INTERVAL_SECONDS=120

# Sync queue limits.
SYNC_BATCH_SIZE=50
SYNC_LIMIT=200
SYNC_MAX_ATTEMPTS=5

# ============================================================================
# AUTO-FETCH MISSING DATA CONFIGURATION
# ============================================================================

# Auto-fetch missing products from Tally when DC fetch encounters them
# Set to 'true' to automatically fetch and save missing products
# Set to 'false' to skip missing products and log them
AUTO_FETCH_PRODUCTS=true

# Auto-fetch missing customers from Tally when DC fetch encounters them
# Set to 'true' to automatically fetch and save missing customers
# Set to 'false' to skip missing customers and log them
AUTO_FETCH_CUSTOMERS=true

# PostgreSQL direct access (optional - used by verification tools and dashboard checks)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catalytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_JSON=false

# ============================================================================
# WEB UI / STARTUP
# ============================================================================
# Use 0.0.0.0 so the dashboard is reachable from this PC and other systems.
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8787
AUTO_OPEN_DASHBOARD=true
AUTO_START_AUTOMATION=false
DASHBOARD_DEBUG=false
AUTO_REGISTER_WINDOWS_STARTUP=true
# When launching the same EXE again, close the currently running dashboard instance.
TOGGLE_EXISTING_INSTANCE_ON_LAUNCH=true
WINDOWS_STARTUP_APP_NAME=ChennaiOxygenMiddlewareDashboard
