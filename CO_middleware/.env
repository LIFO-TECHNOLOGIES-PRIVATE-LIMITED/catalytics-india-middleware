# Chennai Oxygen Middleware Configuration

# ============================================================================
# ENTITY CONFIGURATION
# ============================================================================
ENTITY_NAME=CHENNAI OXYGEN
ENTITY_ID=29

# Used when invoice does not contain godown/location/filling station.
DEFAULT_FILLING_STATION=21

# ============================================================================
# CATALYTICS BACKEND API
# ============================================================================
# CATALYTICS_API_BASE_URL=https://pocapi.catalytics.us/import
CATALYTICS_API_BASE_URL=https://pocapi.catalytics.us/import
CATALYTICS_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzc0NDMyOTc0LCJpYXQiOjE3NzQyNTI5NzQsImp0aSI6IjM0MmM0ODA5ODI2YTQ4YjdhNzY3ZjJkYjE3NGFkN2JlIiwidXNlcl9pZCI6NzR9.P8UwOfA0hyTM8h4Wz9kuxVPUjTqKYQqSNa_qNaqSkUk

# Entity ID used in all API sync calls — must match entity in Catalytics server
# (ENTITY_ID is aliased to CATALYTICS_ENTITY_ID automatically by config.py)


# ============================================================================
# TALLY CONFIGURATION
# ============================================================================
TALLY_URL=http://localhost:9000/

# Single active company (used by fetch_invoices, sync_catalytics, sync_customers, sync_products)
TALLY_COMPANY=CHENNAI OXYGEN 2025-26

# Multi-company support (TALLY_COMPANY_ACTIVE controls which are used)
TALLY_COMPANY_1=CHENNAI OXYGEN 2025-26
TALLY_COMPANY_2=
TALLY_COMPANY_3=
TALLY_COMPANY_4=
TALLY_COMPANY_ACTIVE=COMPANY_1

# Stock-item type code map used by fetch_products.py parser
PRODUCT_TYPE_MAP=CYL:CYLINDER,PLT:PALLET,TNK:TANK,CON:CONTAINER

# Tally request cooldown between API calls (seconds)
TALLY_REQUEST_COOLDOWN=2.0

# Fetch stock item details with each DC (slow — keep false for speed)
TALLY_FETCH_STOCK=false
TALLY_FETCH_FULL_PRODUCTS=false
TALLY_FETCH_FULL_PRODUCTS_AUTO_CODE=false
TALLY_FETCH_FULL_PRODUCTS_AUTO_HSN=false

# How many days back to fetch DCs (0 = today only)
TALLY_DAYS_BACK=0

# Only fetch DCs whose reference fields contain at least one of these keywords (comma-separated, case-insensitive)
# Leave empty to fetch all DCs regardless of reference
DC_REFERENCE_KEYWORDS=delivery,Customer Pik Up,supplier,traders

# ============================================================================
# DATABASE
# ============================================================================
# Master data (customers, products)
# SQLITE_DB_PATH=chennai4.sqlite

# DC / delivery notes database
TALLY_DB_PATH=C:\Github\catalytics-india-middleware\CO_middleware\one.sqlite

# ============================================================================
# SYNC CONFIGURATION
# ============================================================================
SYNC_BATCH_SIZE=10
SYNC_LIMIT=10000
SYNC_MAX_ATTEMPTS=100

# ============================================================================
# AUTOMATION INTERVALS
# ============================================================================
# Fetch master data (products + customers together) — every N minutes
FETCH_MASTER_INTERVAL_MINUTES=10

# Fetch DCs from Tally — every N seconds
FETCH_INVOICES_INTERVAL_SECONDS=40

# Sync everything to Catalytics — every N seconds
SYNC_INVOICES_INTERVAL_SECONDS=60

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_JSON=false

# ============================================================================
# WEB UI / STARTUP
# ============================================================================
WEB_UI_HOST=localhost
WEB_UI_PORT=8787
AUTO_OPEN_DASHBOARD=false
AUTO_START_AUTOMATION=false
DASHBOARD_DEBUG=false
AUTO_REGISTER_WINDOWS_STARTUP=true
WINDOWS_STARTUP_APP_NAME=ChennaiOxygenMiddlewareDashboard
