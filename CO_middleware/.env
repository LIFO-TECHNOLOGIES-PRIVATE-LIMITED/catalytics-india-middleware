# ============================================================================
# TALLY CONFIGURATION
# ============================================================================
TALLY_URL=http://localhost:9000/
#TALLY_URL=http://192.168.1.38:9000/

# Single active company (used by fetch_invoices, sync_catalytics, sync_customers, sync_products)
TALLY_COMPANY=CHENNAI OXYGEN

# Multi-company support (TALLY_COMPANY_ACTIVE controls which are used)
TALLY_COMPANY_1=CHENNAI OXYGEN
TALLY_COMPANY_2=
TALLY_COMPANY_3=
TALLY_COMPANY_4=
TALLY_COMPANY_ACTIVE=COMPANY_1

# Stock-item type code map used by fetch_products.py parser
PRODUCT_TYPE_MAP=CYL:CYLINDER,PLT:PALLET,TNK:TANK,CON:CONTAINER,VAPORIZER:VAPORIZER

# Products to fetch by exact keyword match (no variant/brackets required).
# Comma-separated keywords (case-insensitive). If a stock item name contains
# any of these words it will be saved as-is, ignoring the type-code rule.
# Leave empty to keep the default behaviour (only bracketed items are fetched).
PRODUCT_EXACT_KEYWORDS=

# Tally request cooldown between API calls (seconds)
TALLY_REQUEST_COOLDOWN=5.0

# Fetch stock item details with each DC (slow - keep false for speed)
TALLY_FETCH_STOCK=false

# DC fetch date window (covers weekend gaps for instant DC matching)
DC_PAST_DAYS=3
DC_FUTURE_DAYS=1

#TALLY_FROM_DATE=20260330
#TALLY_TO_DATE=20260401

# Only fetch DCs whose reference fields contain at least one of these keywords (comma-separated, case-insensitive)
# Leave empty to fetch all DCs regardless of reference
DC_REFERENCE_KEYWORDS=delivery,Customer Pik Up,supplier,traders


# DC / delivery notes database
TALLY_DB_PATH=C:\Github\catalytics-india-middleware\CO_middleware\12may_co_db.sqlite
# TALLY_DB_PATH=/home/thiru/Documents/Github/Local/catalytics-india-middleware/CO_middleware

# ============================================================================
# SYNC CONFIGURATION
# ============================================================================
SYNC_BATCH_SIZE=10
SYNC_LIMIT=10000
SYNC_MAX_ATTEMPTS=100

# ============================================================================
# AUTO-FETCH MISSING DATA CONFIGURATION
# ============================================================================
# Enable daily full refresh of ALL products/customers from Tally
AUTO_FETCH_PRODUCTS=true
AUTO_FETCH_CUSTOMERS=true

# ============================================================================
# AUTOMATION INTERVALS
# ============================================================================
# Combined DC fetch + sync cycle interval (seconds).
# Fetch and sync run in a single thread — no lock competition.
# DCs reach Catalytics within 10-20s of appearing in Tally.
FETCH_SYNC_INTERVAL_SECONDS=10

# Daily master sync time (HH:MM). Products + customers fetched and synced once per day.
MASTER_SYNC_TIME=10:00

# Retry interval (minutes) if daily master sync fails.
MASTER_SYNC_FAILURE_RETRY_MINUTES=30

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_JSON=false

# ============================================================================
# WEB UI / STARTUP
# ============================================================================
WEB_UI_HOST=localhost
WEB_UI_PORT=8787
AUTO_OPEN_DASHBOARD=false
AUTO_START_AUTOMATION=true
DASHBOARD_DEBUG=false
AUTO_REGISTER_WINDOWS_STARTUP=true
WINDOWS_STARTUP_APP_NAME=ChennaiOxygenMiddlewareDashboard
