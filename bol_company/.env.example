# BOL Middleware Configuration

# ============================================================================
# ENTITY CONFIGURATION
# ============================================================================
ENTITY_NAME=BOL
ENTITY_ID=30

# Default admin user ID for created_by / modified_by in Catalytics backend
DEFAULT_ADMIN_USER_ID=55

# Used when invoice does not contain godown/location/filling station.
DEFAULT_FILLING_STATION=Main Warehouse
DEFAULT_FILLING_STATION_ID=24

# ============================================================================
# CATALYTICS BACKEND API
# ============================================================================
CATALYTICS_API_BASE=http://localhost:8000/
CATALYTICS_API_KEY=your-api-key-here

# ============================================================================
# TALLY CONFIGURATION
# ============================================================================
TALLY_URL=http://localhost:9000/
TALLY_REQUEST_COOLDOWN=2.0
# Keep Tally running on this URL; invoice fetch depends on a live XML server at port 9000 (no proxies).

# Multi-Company Configuration (4 companies)
TALLY_COMPANY_1=SHREYAA ENTERPRISES
TALLY_COMPANY_2=Surya Air System
TALLY_COMPANY_3=
TALLY_COMPANY_4=

# Active Companies (comma-separated: COMPANY_1,COMPANY_2,COMPANY_3,COMPANY_4)
# Start with 2 companies, add more after testing
TALLY_COMPANY_ACTIVE=COMPANY_1,COMPANY_2

# Stock-item type code map used by fetch_products.py parser.
# Stock item format: PRODUCT_NAME QTY UNIT (TYPE_CODE)
# Example: INDUSTRIAL OXYGEN 4 CUM (CYL) -> product=INDUSTRIAL OXYGEN, variant=4 CUM, type=CYLINDER
PRODUCT_TYPE_MAP=CYL:CYLINDER,PLT:PALLET,TNK:TANK,CON:CONTAINER

# ============================================================================
# SYNC CONFIGURATION
# ============================================================================
SYNC_INTERVAL_SECONDS=120
FETCH_CUSTOMERS_INTERVAL_MINUTES=60
FETCH_PRODUCTS_INTERVAL_MINUTES=60
CUSTOMER_SYNC_WORKERS=5

# Inclusive start date for invoice fetch (YYYYMMDD). Example: 20260228.
# Middleware fetches this date and later dates.
# Leave empty to fetch only today's invoices.
INVOICE_FETCH_START_DATE=20250101

# Daily master sync time (HH:MM) - fetch + sync all customers & products once per day
# Runs immediately on first startup, then daily at this time
MASTER_SYNC_TIME=02:00
MASTER_SYNC_FAILURE_RETRY_MINUTES=30

# Automation intervals (dashboard automation manager)
FETCH_MASTER_INTERVAL_MINUTES=60
FETCH_INVOICES_INTERVAL_MINUTES=30
SYNC_INVOICES_INTERVAL_SECONDS=120
SYNC_MASTER_INTERVAL_MINUTES=5

# ============================================================================
# VERIFICATION SETTINGS
# ============================================================================
VERIFY_AFTER_SYNC=true
VERIFY_RETRY_COUNT=3
VERIFY_RETRY_DELAY_SECONDS=1
VERIFY_TIMEOUT_SECONDS=10
RUN_DAILY_AUDIT=true
AUDIT_TIME=02:00

# ============================================================================
# DATABASE
# ============================================================================
# DB path: filename, directory, or absolute path.
#   "bol.sqlite"        -> BASE_DIR/bol.sqlite (uses existing if present, creates if not)
#   "data/"             -> data/{ENTITY_NAME}.sqlite (auto-derived from ENTITY_NAME)
#   ""  (empty/missing) -> BASE_DIR/{ENTITY_NAME}.sqlite
#   (same creation rules as CO_middleware: directories auto-created, files touched before use)
SQLITE_DB_PATH=data/
# Optional override (mirrors CO_middleware): set TALLY_DB_PATH to an absolute path, directory, or filename to force the SQLite file location.
# Example: TALLY_DB_PATH=C:\Github\catalytics-india-middleware\CO_middleware\local_db.sqlite

# PostgreSQL direct access (optional - for direct verification)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bol
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lifo@123

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/bol.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# WEB UI
# ============================================================================
WEB_UI_PORT=8787
WEB_UI_HOST=localhost

# Dashboard Startup Behavior
# AUTO_OPEN_DASHBOARD: open browser automatically when app starts
AUTO_OPEN_DASHBOARD=true

# AUTO_START_AUTOMATION: auto-start fetch/sync loops when dashboard starts
AUTO_START_AUTOMATION=false

# DASHBOARD_DEBUG: keep false for client/no-console release
DASHBOARD_DEBUG=false

# AUTO_REGISTER_WINDOWS_STARTUP: register EXE in Windows startup on launch
AUTO_REGISTER_WINDOWS_STARTUP=true

# WINDOWS_STARTUP_APP_NAME: registry key name under HKCU\...\Run
WINDOWS_STARTUP_APP_NAME=BOLMiddlewareDashboard
