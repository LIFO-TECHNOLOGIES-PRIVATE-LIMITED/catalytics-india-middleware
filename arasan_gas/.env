# Arasan Gas Middleware Configuration

# ============================================================================
# ENTITY CONFIGURATION
# ============================================================================
ENTITY_NAME=Arasan Gas
ENTITY_ID=30

# Default admin user ID for created_by / modified_by in Catalytics backend
DEFAULT_ADMIN_USER_ID=55

# Used when invoice does not contain godown/location/filling station.
DEFAULT_FILLING_STATION=Main Warehouse
DEFAULT_FILLING_STATION_ID=24

# ============================================================================
# CATALYTICS BACKEND API
# ============================================================================
CATALYTICS_API_BASE=http://localhost:8000/
CATALYTICS_API_KEY=yeyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoxLCJ1c2VybmFtZSI6ImFkbWluIiwiZXhwIjoxNzQwMzk2Mjg2fQ.8kZ0YqZ3ZqZ3ZqZ3ZqZ3ZqZ3ZqZ3ZqZ3ZqZ3ZqZ3ZqZ

# ============================================================================
# TALLY CONFIGURATION
# ============================================================================
TALLY_URL=http://192.168.1.115:9000/
# TALLY_URL=http://localhost:9000/
TALLY_REQUEST_COOLDOWN=2.0

# Multi-Company Configuration (4 companies)
TALLY_COMPANY_1=SHIVAJI & CO.,
TALLY_COMPANY_2=SHREYAA ENTERPRISES
TALLY_COMPANY_3=shivaa Air System
TALLY_COMPANY_4=Surya Air System

# Active Companies (comma-separated: COMPANY_1,COMPANY_2,COMPANY_3,COMPANY_4)
TALLY_COMPANY_ACTIVE=COMPANY_1,COMPANY_2,COMPANY_3,COMPANY_4

# Stock-item type code map used by fetch_products.py parser.
PRODUCT_TYPE_MAP=CYL:CYLINDER,PLT:PALLET,CON:CONTAINER

# Customer ledger groups to fetch from Tally (comma-separated)
CUSTOMER_LEDGER_GROUPS=Sundry Debtors

# ============================================================================
# SYNC CONFIGURATION
# ============================================================================
# Invoice fetch rolling window
# Each cycle fetches: now - DC_PAST_DAYS to now + DC_FUTURE_DAYS
DC_PAST_DAYS=2
DC_FUTURE_DAYS=0

# Inclusive start date for invoice fetch (YYYYMMDD). Leave empty for rolling window only.
INVOICE_FETCH_START_DATE=

# Combined fetch+sync cycle interval (seconds)
FETCH_SYNC_INTERVAL_SECONDS=10

# Daily master sync time (HH:MM) - fetch + sync all customers & products once per day
# Runs immediately on first startup, then daily at this time
MASTER_SYNC_TIME=10:00
MASTER_SYNC_FAILURE_RETRY_MINUTES=30

# ── Loop / sleep timings ─────────────────────────────────────────────────────
# How often the combined invoice fetch+sync loop runs (seconds)
INVOICE_FETCH_SYNC_LOOP_SECONDS=10
# Cooldown after automation restart (seconds)
AUTOMATION_RESTART_SLEEP_SECONDS=2
# Wait between Tally batch requests in invoice fetch (seconds)
INVOICE_BATCH_SLEEP_SECONDS=2
# Error-recovery wait in invoice fetch+sync loop (seconds)
LOOP_ERROR_RECOVERY_SECONDS=10
# Error-recovery wait in daily master loop (seconds)
DAILY_MASTER_ERROR_WAIT_SECONDS=60

# ── API request timeouts ─────────────────────────────────────────────────────
# Catalytics POST timeout for invoice DC sync (seconds)
API_TIMEOUT_INVOICE_SYNC=180
# Catalytics POST timeout for customer/product batch sync (seconds)
API_TIMEOUT_BATCH_SYNC=120
# Catalytics GET timeout for filling-station / health lookups (seconds)
API_TIMEOUT_SHORT=10
# Tally voucher (Day Book) fetch timeout (seconds)
TALLY_TIMEOUT_VOUCHER=300
# Tally ledger fetch timeout (seconds)
TALLY_TIMEOUT_LEDGER=30
# Tally connection-check timeout in dashboard (seconds)
TALLY_CHECK_TIMEOUT=5
# Catalytics connection-check timeout in dashboard (seconds)
CATALYTICS_CHECK_TIMEOUT=2
# PostgreSQL connect timeout for direct DB operations (seconds)
POSTGRES_CONNECT_TIMEOUT=10

# ============================================================================
# INVOICE FETCH SETTINGS
# ============================================================================
# Set true to only accept invoices that have a delivery reference in Tally
REQUIRE_DELIVERY_REF=false

# ============================================================================
# VERIFICATION SETTINGS
# ============================================================================
VERIFY_AFTER_SYNC=true
VERIFY_RETRY_COUNT=3
VERIFY_RETRY_DELAY_SECONDS=1
VERIFY_TIMEOUT_SECONDS=10
RUN_DAILY_AUDIT=true
AUDIT_TIME=02:00

# ============================================================================
# DATABASE
# ============================================================================
# DB path: filename, directory, or absolute path.
#   "data/"             -> data/{ENTITY_NAME}.sqlite
#   ""  (empty/missing) -> BASE_DIR/{ENTITY_NAME}.sqlite
SQLITE_DB_PATH=data/

# PostgreSQL direct access (optional - for direct verification)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arasan_gas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lifo@123

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/arasan_gas.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ============================================================================
# WEB UI
# ============================================================================
WEB_UI_PORT=8787
WEB_UI_HOST=localhost
AUTO_OPEN_DASHBOARD=false
AUTO_START_AUTOMATION=true
DASHBOARD_DEBUG=false
AUTO_REGISTER_WINDOWS_STARTUP=true
WINDOWS_STARTUP_APP_NAME=ArasanGasMiddlewareDashboard
